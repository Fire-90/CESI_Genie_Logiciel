<UserControl x:Class="Graphic.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Border Background="White" CornerRadius="10" Padding="30" MaxWidth="800" VerticalAlignment="Top">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Opacity="0.08" ShadowDepth="4"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="{Binding LanguageService[Settings]}" FontSize="28" FontWeight="Bold" Margin="0,0,0,30" Foreground="#2C3E50"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Langue / Language" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,25">
                            <Button Content="EN" Command="{Binding ChangeLanguageCommand}" CommandParameter="EN" Width="60" Height="35" Margin="0,0,10,0"/>
                            <Button Content="FR" Command="{Binding ChangeLanguageCommand}" CommandParameter="FR" Width="60" Height="35"/>
                        </StackPanel>

                        <TextBlock Text="{Binding LanguageService[LblLogFormat]}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding AvailableLogFormats}" SelectedItem="{Binding SelectedLogFormat}" Height="35" Margin="0,0,0,25"/>

                        <TextBlock Text="{Binding LanguageService[LblEncryptedExt]}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding EncryptedExtensionsString}" Height="35" Margin="0,0,0,25" Padding="5" VerticalContentAlignment="Center"/>

                        <TextBlock Text="{Binding LanguageService[LblPriorityExt]}" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#34495E"/>
                        <TextBox Text="{Binding PriorityExtensionsString, UpdateSourceTrigger=PropertyChanged}" Height="35" Padding="5" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{Binding LanguageService[Softwares]}" FontWeight="SemiBold" Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding NewSoftware, UpdateSourceTrigger=PropertyChanged}" Height="35" Padding="5" Margin="0,0,10,0" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" Content="+" Command="{Binding AddSoftwareCommand}" Width="40" Background="#3498DB" Foreground="White" FontSize="18" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                        </Grid>

                        <ListBox ItemsSource="{Binding Softwares}" SelectedItem="{Binding SelectedSoftware}" Height="140" Margin="0,0,0,10" Padding="5" BorderBrush="#BDC3C7"/>

                        <Button Content="{Binding LanguageService[BtnDelete]}" Command="{Binding RemoveSoftwareCommand}" Padding="15,5" Background="#E74C3C" Foreground="White" FontWeight="Bold" BorderThickness="0" HorizontalAlignment="Right" Cursor="Hand"/>
                    </StackPanel>
                </Grid>

                <Separator Margin="0,30,0,20"/>
                <Button Content="{Binding LanguageService[SaveSettings]}" Command="{Binding SaveSettingsCommand}" Background="#2ECC71" Foreground="White" Padding="30,12" HorizontalAlignment="Right" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>