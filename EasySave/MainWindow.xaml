<Window x:Class="Graphic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Graphic.Views"
        Title="{Binding LanguageService[Title]}" Height="650" Width="950" MinHeight="550" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9">

    <Grid>
        <TabControl Background="Transparent" BorderThickness="0" SelectionChanged="TabControl_SelectionChanged">
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="{Binding DataContext.LanguageService[TabJobs], RelativeSource={RelativeSource AncestorType=Window}}" />
                </TabItem.Header>
                <views:JobManagementTab />
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="{Binding DataContext.LanguageService[TabProcesses], RelativeSource={RelativeSource AncestorType=Window}}" />
                </TabItem.Header>
                <views:ProcessTab />
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="{Binding DataContext.LanguageService[TabSettings], RelativeSource={RelativeSource AncestorType=Window}}" />
                </TabItem.Header>
                <views:SettingsView />
            </TabItem>
        </TabControl>
    </Grid>
</Window>