<Window x:Class="Graphic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Graphic.Views"
        Title="{Binding UIStrings[Title]}" Height="650" Width="950" MinHeight="550" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9">
    <Grid>
        <TabControl Background="Transparent" BorderThickness="0">

            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="{Binding DataContext.UIStrings[TabJobs], RelativeSource={RelativeSource AncestorType=Window}}" />
                </TabItem.Header>
                <views:JobManagementTab />
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="{Binding DataContext.UIStrings[TabProcesses], RelativeSource={RelativeSource AncestorType=Window}}" />
                </TabItem.Header>
                <views:ProcessTab />
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="{Binding DataContext.UIStrings[TabSettings], RelativeSource={RelativeSource AncestorType=Window}}" />
                </TabItem.Header>
                <views:SettingsView />
            </TabItem>

        </TabControl>
    </Grid>
</Window>