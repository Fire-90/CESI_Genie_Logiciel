<Window x:Class="Graphic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding UIStrings[Title]}" Height="650" Width="950" MinHeight="550" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9">
    <Grid>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- EN-TÊTE ET BOUTONS DE LANGUE -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding UIStrings[Title]}" FontSize="28" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding UIStrings[Settings]}" Command="{Binding ToggleSettingsCommand}" Padding="15,5" Margin="0,0,15,0" Background="#95A5A6" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>

                    <Button Content="EN" Command="{Binding ChangeLanguageCommand}" CommandParameter="EN" Width="35" Height="35" Margin="0,0,10,0" Background="White" BorderBrush="#BDC3C7" Cursor="Hand"/>
                    <Button Content="FR" Command="{Binding ChangeLanguageCommand}" CommandParameter="FR" Width="35" Height="35" Background="White" BorderBrush="#BDC3C7" Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <!-- DATAGRID -->
            <DataGrid Grid.Row="1" ItemsSource="{Binding Jobs}"
                      SelectedItem="{Binding SelectedJob}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False" SelectionMode="Single" IsReadOnly="True"
                      GridLinesVisibility="None" RowHeight="35" HeadersVisibility="Column"
                      AlternatingRowBackground="#E8F1F8" Background="White" BorderBrush="#BDC3C7" BorderThickness="1">

                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#2C3E50"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="10,0"/>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" IsReadOnly="True"/>

                    <DataGridTextColumn Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="150">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DataContext.UIStrings[LblName], RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding SourceDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DataContext.UIStrings[LblSource], RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding TargetDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DataContext.UIStrings[LblTarget], RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding Type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DataContext.UIStrings[LblType], RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="Statut" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Margin="5,2">

                                    <Button Content="{Binding DataContext.UIStrings[BtnRun], RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                            Command="{Binding DataContext.ExecuteJobCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            CommandParameter="{Binding}"
                            Background="#2ECC71" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Grid>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0" Margin="0,0,5,0">
                                            <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" Height="20" Foreground="#2ECC71"/>
                                            <TextBlock Text="{Binding Progress, StringFormat={}{0}%}" 
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                       FontSize="11" FontWeight="Bold" Foreground="Black"/>
                                        </Grid>

                                        <Button Grid.Column="1" Width="30" Height="20" Margin="0,0,5,0"
                                                Command="{Binding DataContext.PauseJobCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Background="#E67E22" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Content" Value="⏸"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                            <Setter Property="Content" Value="▶"/>
                                                            <Setter Property="Background" Value="#3498DB"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Button Grid.Column="2" Width="30" Height="20"
                                                Command="{Binding DataContext.StopJobCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Background="#E74C3C" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                                                Content="⏹"/>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- ZONE D'ÉDITION ET D'ACTION -->
            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LIGNE 1 : Nom et Type (Désactivé si rien n'est sélectionné) -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,15,10" IsEnabled="{Binding IsJobSelected}">
                    <TextBlock Text="{Binding UIStrings[LblName]}" Margin="0,0,0,5" FontWeight="SemiBold" Foreground="#34495E"/>
                    <TextBox Text="{Binding SelectedJob.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="30" Padding="5" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="15,0,0,10" IsEnabled="{Binding IsJobSelected}">
                    <TextBlock Text="{Binding UIStrings[LblType]}" Margin="0,0,0,5" FontWeight="SemiBold" Foreground="#34495E"/>
                    <ComboBox ItemsSource="{Binding AvailableTypes}" SelectedItem="{Binding SelectedJob.Type, Mode=TwoWay}" Height="30" Padding="5" VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- LIGNE 2 : Source et Cible (Désactivé si rien n'est sélectionné) -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,15,20" IsEnabled="{Binding IsJobSelected}">
                    <TextBlock Text="{Binding UIStrings[LblSource]}" Margin="0,0,0,5" FontWeight="SemiBold" Foreground="#34495E"/>
                    <TextBox Text="{Binding SelectedJob.SourceDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="30" Padding="5" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="15,0,0,20" IsEnabled="{Binding IsJobSelected}">
                    <TextBlock Text="{Binding UIStrings[LblTarget]}" Margin="0,0,0,5" FontWeight="SemiBold" Foreground="#34495E"/>
                    <TextBox Text="{Binding SelectedJob.TargetDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="30" Padding="5" VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- LIGNE 3 : Infos progression et Boutons -->
                <StackPanel Grid.Row="2" Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding UIStrings[Recent]}" FontWeight="Bold" Foreground="Gray"/>
                    <TextBlock Text="{Binding CurrentFile}" FontStyle="Italic" TextTrimming="CharacterEllipsis" Foreground="#34495E"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{Binding UIStrings[BtnAdd]}" Command="{Binding AddJobCommand}" Padding="20,10" Margin="0,0,15,0" Background="#3498DB" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="{Binding UIStrings[BtnDelete]}" Command="{Binding DeleteJobCommand}" Padding="20,10" Margin="0,0,15,0" Background="#E74C3C" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- COUCHE 2 : LE MENU DES PARAMÈTRES SUPERPOSÉ (Caché par défaut) -->
        <Border Background="#D8F4F6F9" Panel.ZIndex="10">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Border Background="White" CornerRadius="10" Padding="30" Width="450" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Opacity="0.3" ShadowDepth="4"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="{Binding UIStrings[Settings]}" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" Foreground="#2C3E50"/>

                    <TextBlock Text="{Binding UIStrings[LblLogFormat]}" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#34495E"/>
                    <ComboBox ItemsSource="{Binding AvailableLogFormats}" SelectedItem="{Binding SelectedLogFormat, Mode=TwoWay}" Height="30" Padding="5" Margin="0,0,0,15" VerticalContentAlignment="Center"/>

                    <!-- NOUVEAU : Extensions à chiffrer -->
                    <TextBlock Text="{Binding UIStrings[LblEncryptedExt]}" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#34495E"/>
                    <TextBox Text="{Binding EncryptedExtensionsString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="30" Padding="5" Margin="0,0,0,15" VerticalContentAlignment="Center"/>

                    <TextBlock Text="{Binding UIStrings[Softwares]}" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#34495E"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding NewSoftware, UpdateSourceTrigger=PropertyChanged}" Height="30" Padding="5" Margin="0,0,10,0" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" Content="+" Command="{Binding AddSoftwareCommand}" Width="35" Background="#3498DB" Foreground="White" FontSize="18" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                    </Grid>

                    <ListBox ItemsSource="{Binding Softwares}" SelectedItem="{Binding SelectedSoftware}" Height="100" Margin="0,0,0,10" Padding="5" BorderBrush="#BDC3C7"/>

                    <Button Content="{Binding UIStrings[BtnDelete]}" Command="{Binding RemoveSoftwareCommand}" Padding="15,5" Background="#E74C3C" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,0,25" HorizontalAlignment="Right" Cursor="Hand"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="{Binding UIStrings[Close]}" Command="{Binding ToggleSettingsCommand}" Padding="15,10" Margin="0,0,10,0" Background="#95A5A6" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                        <Button Grid.Column="1" Content="{Binding UIStrings[SaveSettings]}" Command="{Binding SaveSettingsCommand}" Padding="20,10" Background="#2ECC71" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>