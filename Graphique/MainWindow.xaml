<Window x:Class="Graphique.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasySave 2.0 - ProSoft" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,0,0,15">
            <TextBlock Text="EasySave 2.0" FontSize="24" FontWeight="Bold" Foreground="#2C3E50"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="EN" Width="30" Height="30" Margin="0,0,5,0"/>
                <Button Content="FR" Width="30" Height="30"/>
            </StackPanel>
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Jobs}" 
                  SelectedItem="{Binding SelectedJob}" 
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False" SelectionMode="Single" IsReadOnly="False"
                  GridLinesVisibility="Horizontal" AlternatingRowBackground="#F9F9F9">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" IsReadOnly="True"/>
                <DataGridTextColumn Header="Nom" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                <DataGridTextColumn Header="Source" Binding="{Binding SourceDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                <DataGridTextColumn Header="Cible" Binding="{Binding TargetDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                <DataGridTextColumn Header="Type" Binding="{Binding Type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Inputs for creating a new job: Source and Cible (Target) -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Orientation="Vertical" Width="350">
                    <TextBlock Text="Source (Source folder)" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewSourceDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Orientation="Vertical" Width="350">
                    <TextBlock Text="Cible (Target folder)" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewTargetDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Ajouter un travail" 
                        Command="{Binding AddJobCommand}" 
                        Padding="15,8" Margin="0,0,10,0" Background="#3498DB" Foreground="White"/>

                <Button Content="▶ Lancer la sélection" 
                        Command="{Binding ExecuteSelectionCommand}" 
                        Padding="15,8" Background="#2ECC71" Foreground="White"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>